[Unit]
Description=MingLu visual assistant
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Environment=MINGLU_PROFILE=kneopi
Environment=MINGLU_HOME=@HOME@
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@HOME@/app
ExecStart=@HOME@/venv/bin/python -m app.server --https
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
