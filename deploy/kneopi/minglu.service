[Unit]
Description=MingLu visual assistant
After=network-online.target
Wants=network-online.target

[Service]
Environment=MINGLU_PROFILE=kneopi
Environment=MINGLU_HOME=/opt/minglu
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/minglu/app
ExecStart=/opt/minglu/venv/bin/python -m app.server --https
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
